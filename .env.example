# Copy to .env (never commit .env). Generate a key: python -c "import secrets;print(secrets.token_hex(32))"
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-value
DATABASE_PATH=/data/servicepro.db
APP_TIMEZONE=Asia/Kolkata
# Optional: creates the first admin on startup ONLY when no users exist. Remove after first login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password-min-10-chars
